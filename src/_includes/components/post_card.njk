<article class="post-card">
  {% if post.data.cover %}
    <a class="cover" href="{{ env.base }}{{ post.url }}">
      <img src="{{ env.base }}{{ post.data.cover }}" alt="" loading="lazy" />
    </a>
  {% endif %}
  <div class="card-body">
    <h2><a href="{{ env.base }}{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="meta">
      <time datetime="{{ post.date | htmlDateString }}">{{ post.date | date }}</time> · {{ post.templateContent | readTime }}
    </p>
    <p class="excerpt">{{ post.data.description or (post.templateContent | excerpt(24)) }}</p>
  </div>
</article>
