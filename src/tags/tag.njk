---
layout: layouts/base.njk
pagination:
  data: collections.tagList
  size: 1
  alias: tag
  addAllPagesToCollections: true
permalink: /tag/{{ tag | url }}/
---

<div class="wrap-narrow tag-head">
  <p class="meta"><a href="{{ env.base }}/tags/">← All topics</a></p>
  <h1>#{{ tag }}</h1>
  <div class="posts">
    {% for post in collections[tag] %}
      {% include "../_includes/components/post_card.njk" %}
    {% endfor %}
  </div>
</div>
