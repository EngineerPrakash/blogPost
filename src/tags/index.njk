---
layout: layouts/base.njk
title: Tags
permalink: /tags/
---

<div class="wrap-narrow tag-head">
  <h1>Topics</h1>
  <div class="tag-cloud">
    {% for tag in collections.tagList %}
      <a class="chip" style="font-size:1rem;padding:6px 16px" href="{{ env.base }}/tag/{{ tag | url }}/">{{ tag }} · {{ collections[tag].length }}</a>
    {% endfor %}
    {% if collections.tagList | length == 0 %}<p class="muted">No tags yet.</p>{% endif %}
  </div>
</div>
