---
layout: layouts/base.njk
title: Home
pagination:
  data: collections.posts
  size: 7
  alias: posts
permalink: "/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---

<section class="hero">
  <div class="container">
    <span class="eyebrow">{% set streakDays = collections.posts | streak %}{% if streakDays > 0 %}🔥 {{ streakDays }}-day writing streak{% else %}✍️ New posts, every day{% endif %}</span>
    <h1>{{ site.tagline }}</h1>
    <p class="tagline">{{ site.description }}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#posts">Read latest</a>
      <a class="btn" href="{{ env.base }}/archive/">Browse archive</a>
    </div>
  </div>
</section>

<div class="container">
{% if posts and posts | length > 0 %}
  {% set featured = posts[0] %}
  {% if pagination.pageNumber == 0 %}
  <article class="featured">
    <a class="cover" href="{{ env.base }}{{ featured.url }}">{% if featured.data.cover %}<img src="{{ env.base }}{{ featured.data.cover }}" alt="" loading="lazy" />{% endif %}</a>
    <div class="content">
      <p class="meta"><span class="chip">Latest</span> <time datetime="{{ featured.date | htmlDateString }}">{{ featured.date | date }}</time> · {{ featured.templateContent | readTime }}</p>
      <h2><a href="{{ env.base }}{{ featured.url }}">{{ featured.data.title }}</a></h2>
      <p>{{ featured.data.description or (featured.templateContent | excerpt(36)) }}</p>
      <a class="btn btn-primary" href="{{ env.base }}{{ featured.url }}">Read post →</a>
    </div>
  </article>
  {% endif %}

  <section class="section" id="posts">
    <div class="section-head"><h2>Latest posts</h2></div>
    <div class="posts">
      {% for p in posts %}
        {% if pagination.pageNumber > 0 or not loop.first %}
          {% set post = p %}
          {% include "components/post_card.njk" %}
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% endif %}

<nav class="pager" aria-label="Pagination">
  {% if pagination.href.previous %}<a class="btn" href="{{ env.base }}{{ pagination.href.previous }}">← Newer</a>{% else %}<span></span>{% endif %}
  {% if pagination.href.next %}<a class="btn" href="{{ env.base }}{{ pagination.href.next }}">Older →</a>{% endif %}
</nav>
</div>
